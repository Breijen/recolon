var arr = [1, 2, 3];

arr.pop(2); # Pops 3 in array [1, 2, 3] because it it's the third index (0, 1, 2)
arr.push(5);

log(arr); # Should return [1, 2, 5]
log(arr.length()); # Should return 3

struct Car {
    name: "Toyota",
    x: 0,
    y: 0,
}

var x = Car;

log(x);

# Index assignment
var nums = [10, 20, 30];
nums[1] = 99;
log(nums); # Should return [10, 99, 30]
log(nums[1]); # Should return 99

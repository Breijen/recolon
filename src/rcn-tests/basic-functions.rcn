# Basic variables

var a = 3;
var b = 4;

# Log functions

log("a = " + a);
log("b = " + b);
log("total is: " + (a + b));

if (2.0 == 2.0) {
    log("2.0 is indeed equals 2.0!");
}

if (3 != 3) {
    err("this should not log");
} else {
    log("this should log");
}

# If - Else statements

if (4 == 2) {
    var a = 2;
    log("this should not log");
} else {
    var a = 2;
    err("this is an error");
    log(a);
}

log(a);

